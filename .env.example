# Base de données
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/musees_idf
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=musees_idf

# APIs
OPENAGENDA_API_KEY=<clé_publique_openagenda>
# ANTHROPIC_API_KEY est OPTIONNELLE : uniquement pour l'extraction IA des pages
# de musées sans données structurées. Laisser vide = mode 100 % gratuit.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Mettre false pour désactiver tout appel IA même si une clé est présente
SCRAPER_USE_AI=true

# Email (alertes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alertes@musees-idf.fr

# App
FRONTEND_URL=http://localhost:5173
SECRET_KEY=<random_32_chars>

# Frontend
VITE_API_URL=http://localhost:8000
